# Copy to .env in this directory. Vite reads its own project root, not the repo root.
#
# WARNING: Vite inlines VITE_* into the public client bundle. URLs and flags
# only — never a key, token, or pairing secret.

# WebSocket target for the Mac brain. Default: wss://mac.local:8787/glasses
# Must also be listed as an exact-match domain in app.json.
# VITE_MAC_WS_URL=
