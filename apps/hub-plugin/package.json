{
  "name": "@joat/hub-plugin",
  "version": "0.1.50",
  "private": true,
  "type": "module",
  "description": "Even Hub plugin — owns the G2 and relays audio/IMU/input to the Mac brain over WebSocket.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release-candidates": "node --test scripts/test_release_candidates.mjs scripts/test_release_manifest.mjs",
    "pack": "zsh scripts/pack.sh"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.14",
    "@phosphor-icons/core": "2.1.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
