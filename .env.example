# Copy to .env and fill in what you need. .env is gitignored.
# Everything here is optional — this project runs on subscriptions, not API
# keys. Phase 0: no code reads these yet.

# Metered fallback for CriticAgent only. Normally unset — the critic runs the
# official `claude` binary on your subscription. Pair with --max-budget-usd.
# NEVER put a Claude OAuth token here (docs/RULES.md rule 9).
# ANTHROPIC_API_KEY=

# Embeddings / moderation only. codex-bridge.sh unsets this before running
# Codex, so a /collab run can never bill it.
# OPENAI_API_KEY=

# Verifier Gate fetch fallbacks for 403 / JS-rendered pages
# (docs/ARCHITECTURE.md). r.jina.ai works keyless — add keys only if
# rate-limited. Wayback needs none.
# JINA_API_KEY=
# FIRECRAWL_API_KEY=
# MAPBOX_ACCESS_TOKEN=
# Hub plugin vars (VITE_*) live in apps/hub-plugin/.env — Vite reads its own
# project root, not this one. See apps/hub-plugin/.env.example.
