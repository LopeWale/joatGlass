# Vendor clones (reproduce via scripts/clone_vendors.sh)
vendor/*
!vendor/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/

# Node
node_modules/
dist/

# macOS / editors
.DS_Store
.idea/
.vscode/

# Secrets & local config
.env
*.local.toml

# Cross-model collab workspace (specs, reports, transient codex output)
.collab/

# IMU calibration traces (personal motion data)
traces/

# Python build metadata
*.egg-info/

# Built app bundles
dist/
apps/mac/JOATShell/.build/

# Generated by xcodegen from project.yml
apps/mac/JOATShell/*.xcodeproj

.codex/coordination/*
!.codex/coordination/project.yaml
.playwright-mcp
output/
.claude/ralph-loop.local.md
apps/hub-plugin/public/dev-map-sample.png

# DEV-only synthetic speech, written by
# scripts/simulator_voice_gap_acceptance.py so the official
# simulator can drive the real STT path. Vite copies public/ verbatim into
# every build, and pack.sh refuses any bundle containing a __joat-* path —
# so committing one of these does not just add noise, it BLOCKS RELEASES.
# It was committed once and blocked the first package build of the day.
apps/hub-plugin/public/__joat-audio-fixture/
apps/hub-plugin/public/__joat-dev-fixtures/

build/

# TypeScript incremental build artifact
*.tsbuildinfo

# Personal plugin builds (each build carries its builder's own Mac addresses)
apps/hub-plugin/*.ehpk
