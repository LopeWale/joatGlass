# Vendor clones (reproduce via scripts/clone_vendors.sh)
vendor/*
!vendor/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/

# Node
node_modules/
dist/

# macOS / editors
.DS_Store
.idea/
.vscode/

# Secrets & local config
.env
*.local.toml

# Cross-model collab workspace (specs, reports, transient codex output)
.collab/

# IMU calibration traces (personal motion data)
traces/
# Packed Hub plugin bundles (build artifacts)
*.ehpk

# Python build metadata
*.egg-info/

# Built app bundles
dist/
apps/mac/JOATShell/.build/

# Generated by xcodegen from project.yml
apps/mac/JOATShell/*.xcodeproj
# Seeded design canvases (2MB editor payload — the .dc.html sources are the truth)
docs/design/**/joat-glasses-dashboard.html
